# Database Configuration
# Required: Set a secure password for PostgreSQL
DB_PASSWORD=your_secure_password_here

# Optional: Database username (defaults to "postgres")
# DB_USERNAME=postgres

# Optional: Database name (defaults to "expense_management")
# DB_NAME=expense_management

# JWT Configuration
# Required: Set a secure secret key for JWT token signing (minimum 32 characters)
JWT_SECRET=your_secure_jwt_secret_here

# Optional: Docker image configuration
# DOCKER_IMAGE=lymengouk/expense-management-api
# IMAGE_TAG=latest

# Optional: Application URLs
# BASE_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:3000
